# Copy to .env.instagram.local (git-ignored) and fill in the blanks, then run:
#   npm run fetch-instagram

# --- Instagram scan ---
IG_USERNAME=prepfinland
# Permanent numeric account id. Recommended (the username->id lookup is flaky).
# Find it once at https://www.instagram.com/prepfinland/ -> view source -> search
# "profilePage_" or use any "instagram user id" lookup tool.
IG_USER_ID=44544967003
IG_HASHTAGS=prepfinland,beprepared,preparmy
IG_MAX=60

# --- Cloudflare R2 ---
# Public, non-secret config:
R2_BUCKET=prep-instagram
R2_PREFIX=instagram/
R2_PUBLIC_BASE_URL=https://pub-fa5f4067a9c9487496ccefa1b11f0025.r2.dev
# From Cloudflare R2 -> Overview -> Account details:
R2_ACCOUNT_ID=
# From the R2 API token you created (Object Read & Write):
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
